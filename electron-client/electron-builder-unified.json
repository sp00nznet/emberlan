{
  "appId": "com.emberlan.unified",
  "productName": "Emberlan",
  "directories": {
    "output": "dist/unified"
  },
  "files": [
    "**/*",
    "!dist/**",
    "!scripts/**"
  ],
  "extraResources": [
    {
      "from": "server",
      "to": "server",
      "filter": [
        "**/*"
      ]
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "assets/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Emberlan"
  },
  "extraMetadata": {
    "embeddedServer": true
  }
}
