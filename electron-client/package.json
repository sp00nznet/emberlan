{
  "name": "emberlan-client",
  "version": "1.0.0",
  "description": "Emberlan Desktop Client - Gaming Community Platform",
  "homepage": "https://github.com/sp00nznet/emberlan",
  "main": "main.js",
  "scripts": {
    "prestart": "npm run copy-renderer",
    "start": "electron .",
    "copy-renderer": "node scripts/copy-renderer.js",
    "start:embedded": "electron . --embedded-server",
    "start:headless": "electron . --embedded-server --headless",
    "build": "npm run copy-renderer && electron-builder",
    "build:win": "npm run copy-renderer && electron-builder --win",
    "build:win:unified": "npm run copy-renderer && npm run copy-server && electron-builder --win -c electron-builder-unified.json",
    "build:win:headless": "npm run copy-server && electron-builder --win -c electron-builder-headless.json",
    "copy-server": "node scripts/copy-server.js"
  },
  "build": {
    "appId": "com.emberlan.client",
    "productName": "Emberlan",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!scripts/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "fs-extra": "^11.2.0"
  },
  "author": {
    "name": "Emberlan",
    "email": "admin@emberlan.com"
  },
  "license": "MIT"
}
