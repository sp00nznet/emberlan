{
  "appId": "com.emberlan.server",
  "productName": "Emberlan Server",
  "directories": {
    "output": "dist/headless"
  },
  "files": [
    "main.js",
    "preload.js",
    "package.json",
    "assets/**"
  ],
  "extraResources": [
    {
      "from": "server",
      "to": "server",
      "filter": [
        "**/*"
      ]
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "assets/icon.ico"
  },
  "nsis": {
    "oneClick": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Emberlan Server",
    "runAfterFinish": true
  },
  "env": {
    "EMBERLAN_EMBEDDED_SERVER": "true",
    "EMBERLAN_HEADLESS": "true"
  }
}
