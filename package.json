{
  "name": "emberlan",
  "version": "1.0.0",
  "description": "Emberlan - Gaming Community Platform",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "electron": "cd electron-client && npm start",
    "electron:embedded": "cd electron-client && npm run start:embedded",
    "electron:headless": "cd electron-client && npm run start:headless",
    "build:electron": "cd electron-client && npm run build",
    "build:electron:win": "cd electron-client && npm run build:win",
    "build:win:unified": "cd electron-client && npm run build:win:unified",
    "build:win:headless": "cd electron-client && npm run build:win:headless",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "install:all": "npm install && cd electron-client && npm install"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^2.7.0",
    "nodemailer": "^6.9.7",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.7.2",
    "uuid": "^9.0.1",
    "validator": "^13.11.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.4.3",
    "nodemon": "^3.0.2"
  },
  "keywords": [
    "gaming",
    "community",
    "voice-chat",
    "video-chat",
    "discord-alternative"
  ],
  "author": "Emberlan",
  "license": "MIT"
}
