{
  "name": "emberlan-mobile",
  "version": "1.0.0",
  "description": "Emberlan Mobile Client - Gaming Community Platform",
  "main": "index.js",
  "scripts": {
    "copy-client": "node scripts/copy-client.js",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
    "build:android": "npm run copy-client && npx cap sync android && npm run gradle",
    "run:android": "npx cap run android",
    "gradle": "node -e \"const w=process.platform===`win32`;require(`child_process`).execFileSync(require(`path`).resolve(`android`,w?`gradlew.bat`:`gradlew`),[`assembleDebug`],{cwd:`android`,stdio:`inherit`,shell:w})\""
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/keyboard": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "fs-extra": "^11.2.0"
  },
  "author": "Emberlan",
  "license": "MIT"
}
