{
  "name": "emberlan-mobile",
  "version": "1.0.0",
  "description": "Emberlan Mobile Client - Gaming Community Platform",
  "main": "index.js",
  "scripts": {
    "copy-client": "node scripts/copy-client.js",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
    "build:android": "npm run copy-client && npx cap sync android && cd android && gradlew assembleDebug",
    "run:android": "npx cap run android"
  },
  "dependencies": {
    "@capacitor/android": "^5.6.0",
    "@capacitor/app": "^5.0.6",
    "@capacitor/core": "^5.6.0",
    "@capacitor/keyboard": "^5.0.6",
    "@capacitor/status-bar": "^5.0.6",
    "@capacitor/splash-screen": "^5.0.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^5.6.0",
    "fs-extra": "^11.2.0"
  },
  "author": "Emberlan",
  "license": "MIT"
}
